[Unit]
Description=Verify and install a staged GameLink agent update

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/.gamelink-agent-update-helper update install-staged
# Let the helper finish recovery even if stopping or starting the agent is slow.
TimeoutStartSec=infinity

NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gamelink-agent/update /usr/local/bin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
UMask=0077
