#!/bin/sh
set -eu

account_collision() {
    echo "GameLink cannot reuse the existing gamelink account or group. Use a dedicated system user and group with a nologin shell and no privileged group memberships, or rename the conflicting account or group before retrying configuration." >&2
    exit 1
}

system_id() {
    awk -v kind="$1" -v id="$2" '
        BEGIN { min = 101; regular_min = 1000 }
        $1 == kind "_MIN" { regular_min = $2 }
        $1 == "SYS_" kind "_MIN" { min = $2 }
        $1 == "SYS_" kind "_MAX" { max = $2 }
        END {
            if (max == "") max = regular_min - 1
            exit !(id ~ /^[0-9]+$/ && id > 0 && id >= min && id <= max)
        }
    ' /etc/login.defs
}

case "$1" in
    configure)
        state=/var/lib/gamelink-agent
        if account=$(getent passwd gamelink); then
            group=$(getent group gamelink) || account_collision
            uid=$(printf '%s\n' "$account" | cut -d: -f3)
            gid=$(printf '%s\n' "$group" | cut -d: -f3)
            system_id UID "$uid" || account_collision
            system_id GID "$gid" || account_collision
            [ "$(id -g gamelink)" = "$gid" ] && \
                [ "$(id -gn gamelink)" = gamelink ] || account_collision
            group_entries=$(getent group) || account_collision
            printf '%s\n' "$group_entries" | awk -F: -v gid="$gid" '
                $3 == gid {
                    if ($1 != "gamelink" || ($4 != "" && $4 != "gamelink")) exit 1
                    found = 1
                }
                END { if (!found) exit 1 }
            ' || account_collision
            accounts=$(getent passwd) || account_collision
            printf '%s\n' "$accounts" | awk -F: -v gid="$gid" '
                $4 == gid && $1 != "gamelink" { exit 1 }
            ' || account_collision
            case "${account##*:}" in
                /usr/sbin/nologin|/sbin/nologin) ;;
                *) account_collision ;;
            esac
            groups=$(id -Gn gamelink)
            for group in $groups; do
                case "$group" in
                    root|sudo|wheel|adm|docker|lxd|disk|shadow|libvirt|incus|incus-admin) account_collision ;;
                esac
            done
        else
            if getent group gamelink >/dev/null; then
                account_collision
            fi
            useradd --system --user-group --no-create-home \
                --home-dir "$state" --shell /usr/sbin/nologin gamelink
            uid=$(id -u gamelink)
            gid=$(id -g gamelink)
        fi
        if [ ! -e "$state" ] && [ ! -L "$state" ]; then
            mkdir -m 0700 "$state"
        fi
        # /var/lib is root-owned. Take ownership without following a symlink,
        # then validate the directory before changing modes.
        if [ -L "$state" ] || [ ! -d "$state" ]; then
            echo "GameLink state path must be a directory: $state" >&2
            exit 1
        fi
        if [ "$(stat -c '%u:%g:%a' "$state")" != "$uid:$gid:700" ]; then
            chown -h root:gamelink "$state"
            chmod 0700 "$state"
            chown -h gamelink:gamelink "$state"
        fi
        ;;
    *) exit 0 ;;
esac

# Only an owner-created apt helper is eligible for refresh. A desktop
# transaction keeps its recovery executable until the helper finalizes it.
apt_state=/var/lib/gamelink-agent-apt-update
installer=$apt_state/installer
pending=$apt_state/pending.json
if [ ! -L "$apt_state" ] && [ -d "$apt_state" ] &&
    [ "$(stat -c '%u:%a' "$apt_state")" = 0:750 ] &&
    [ ! -L "$installer" ] && [ -f "$installer" ] &&
    [ "$(stat -c '%u:%a' "$installer")" = 0:755 ] &&
    [ ! -e "$pending" ] && [ ! -L "$pending" ]; then
    next=$(mktemp "$apt_state/.installer.XXXXXXXX")
    trap 'if [ -e "$next" ]; then unlink "$next"; fi' EXIT
    install -m 0755 /usr/bin/gamelink-agent "$next"
    sync "$next"
    mv -fT "$next" "$installer"
    sync "$apt_state"
    trap - EXIT
fi

restart=/run/gamelink-agent-restart
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
if [ -f "$restart" ] && read -r old new active enabled < "$restart" &&
    [ "$old" = "${2:-}" ] &&
    [ "$new" = "$(dpkg-query -W -f='${Version}' gamelink-agent)" ]; then
    unlink "$restart"
    case "$active" in active|reloading|refreshing) ;; *) exit 0 ;; esac
    unit=gamelink-agent.service
    if [ -d /run/systemd/system ] && [ -n "$enabled" ] &&
        current_enabled=$(systemctl is-enabled "$unit") && [ "$current_enabled" = "$enabled" ]; then
        policy=${DPKG_ROOT:-}/usr/sbin/policy-rc.d
        # Only an explicit allow from the policy permits restoration.
        status=0
        if [ -x "$policy" ]; then "$policy" "$unit" start || status=$?; fi
        case "$status" in
            0|104) deb-systemd-invoke start "$unit" ;;
        esac
    fi
fi
