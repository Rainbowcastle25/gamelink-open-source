#!/bin/sh
set -eu

restart=/run/gamelink-agent-restart
case "$1" in
    abort-upgrade)
        # This is the new package's script. dpkg passes both versions even
        # when the old package was only unpacked.
        if [ -f "$restart" ]; then
            if [ -d /run/systemd/system ] && read -r old new < "$restart" &&
                [ "$old" = "${2:-}" ] && [ "$new" = "${3:-}" ]; then
                systemctl daemon-reload
                # Restore even a disabled unit that the owner started manually.
                deb-systemd-invoke reload-or-restart gamelink-agent.service
            fi
            unlink "$restart"
        fi
        ;;
    remove|purge)
        if [ -f "$restart" ]; then
            unlink "$restart"
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
esac
