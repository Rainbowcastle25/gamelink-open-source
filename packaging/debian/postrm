#!/bin/sh
set -eu

restart=/run/gamelink-agent-restart
case "$1" in
    abort-upgrade)
        # This is the new package's script. dpkg passes both versions even
        # when the old package was only unpacked.
        if [ -f "$restart" ] && read -r old new active enabled < "$restart" &&
            [ "$old" = "${2:-}" ] && [ "$new" = "${3:-}" ]; then
            unlink "$restart"
            case "$active" in active|reloading|refreshing) ;; *) exit 0 ;; esac
            if [ -d /run/systemd/system ]; then
                systemctl daemon-reload
                unit=gamelink-agent.service
                if [ -n "$enabled" ] && current_enabled=$(systemctl is-enabled "$unit") &&
                    [ "$current_enabled" = "$enabled" ]; then
                    policy=${DPKG_ROOT:-}/usr/sbin/policy-rc.d
                    # Only an explicit allow from the policy permits restoration.
                    status=0
                    if [ -x "$policy" ]; then "$policy" "$unit" start || status=$?; fi
                    case "$status" in
                        0|104) deb-systemd-invoke start "$unit" ;;
                    esac
                fi
            fi
        fi
        ;;
    remove|purge)
        if [ -f "$restart" ]; then
            unlink "$restart"
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
esac
