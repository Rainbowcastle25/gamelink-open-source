{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameLink",
  "version": "0.1.0",
  "identifier": "dev.gamelink.desktop",
  "build": { "frontendDist": "../desktop/frontend/dist" },
  "app": {
    "windows": [{ "label": "main", "title": "GameLink", "width": 1280, "height": 800, "minWidth": 1000, "minHeight": 680, "backgroundColor": "#080d1a", "theme": "Dark" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
